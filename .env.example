# Default provider for the first live evaluation: kimi | deepseek | openai
AI_PROVIDER=kimi

# Kimi: strict JSON Schema output. Recommended first test model.
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.cn/v1

# DeepSeek: valid JSON output plus the product's semantic validator.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional OpenAI adapter retained for portability.
OPENAI_API_KEY=
OPENAI_MODEL=
